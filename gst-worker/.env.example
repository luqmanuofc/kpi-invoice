# Copy to .env on the VPS. Never commit the real values.

# Long random string -- must match GST_WORKER_SECRET in the Netlify app's
# environment variables exactly. Generate one with: openssl rand -hex 32
WORKER_SHARED_SECRET=

# Optional, defaults to 8420 (chosen to avoid colliding with common dev
# ports -- 3000/5000/5173/8080/8888/9000 are all typically already in use).
# Whatever you point `tailscale funnel` at.
PORT=8420
