# Server-side password for backend authentication (keep this secret)
APP_PASSWORD=your-secure-password-here

# JWT secret for signing tokens (keep this secret - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-jwt-secret-here

# Database connection string
DATABASE_URL=your-database-connection-string

# Epson Connect API app credentials (from developer.epsonconnect.com/applications/list)
EPSON_CLIENT_ID=your-epson-client-id
EPSON_CLIENT_SECRET=your-epson-client-secret
EPSON_API_KEY=your-epson-api-key

# gst-worker (see gst-worker/README.md) -- its Tailscale Funnel URL and the
# shared secret matching that box's WORKER_SHARED_SECRET. Without these,
# startGstLookup/submitGstCaptcha return 503 and BuyerDrawer's "Fetch GST
# Info" button surfaces that as an error, same as any other misconfiguration.
GST_WORKER_URL=https://your-machine.your-tailnet.ts.net
GST_WORKER_SECRET=your-worker-shared-secret
