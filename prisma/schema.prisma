generator client {
  provider = "prisma-client"
  output   = "../netlify/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// BUYER
//
model Buyer {
  id      String  @id @default(cuid())
  name    String  @unique
  address String
  gstin   String?
  phone   String?

  // Ship-to PIN/state for e-way bills -- manual entry, and *only* meaningful
  // for a buyer with no GSTIN (URP). A buyer with a GSTIN has no use for
  // these: their PIN/state always come from the latest matching row in
  // GstVerification below instead (never cached here -- there is nowhere
  // for a stale duplicate to hide). scripts/gstin-lookup never writes to
  // these columns; only the buyer create/update form does, and only when
  // the buyer has no GSTIN (see BuyerDrawer.tsx).
  pincode   Int?
  stateCode Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices         Invoice[]
  gstVerifications GstVerification[]
}

//
// GST VERIFICATION (one row per scripts/gstin-lookup run -- the only place
// a GSTIN buyer's legal name/trade name/address/pincode/stateCode live;
// nothing here is cached back onto Buyer)
//
model GstVerification {
  id String @id @default(cuid())

  buyerId String
  buyer   Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  // Snapshot of the GSTIN this row was verified against -- Buyer.gstin can
  // change later. "Verified" is derived at read time by checking this
  // still equals the buyer's current gstin (see isBuyerGstVerified in
  // src/api/buyers.ts) rather than tracked with its own flag/column, so a
  // changed GSTIN can't leave a stale "verified" status lying around.
  gstin String

  verifiedAt DateTime @default(now())

  // Headline fields, typed for easy display/querying.
  legalName              String?
  tradeName              String?
  registrationDate       String? // as shown by the portal, dd/mm/yyyy text -- not parsed, to avoid a scrape bug silently corrupting a DateTime
  constitutionOfBusiness String?
  gstinStatus            String? // e.g. "Active"
  taxpayerType           String? // e.g. "Regular"
  principalAddress       String?
  pincode                Int?
  stateCode              Int?

  // Everything else the portal returns -- jurisdiction (administrative +
  // state office lines), Aadhaar/e-KYC verification status, nature of core
  // business activity, nature of business activities, and the HSN/SAC goods
  // & services table -- kept as JSON rather than modelled field-by-field so
  // a portal layout change doesn't silently drop data or need a migration
  // just to keep capturing it. See scripts/gstin-lookup for the shape.
  raw Json?

  createdAt DateTime @default(now())

  @@index([buyerId])
  @@index([gstin])
}

//
// PRODUCT
//
model Product {
  id           String  @id @default(cuid())
  name         String  @unique
  hsn          String
  defaultUnit  String
  defaultPrice Decimal @db.Decimal(10, 2)

  category ProductCategory

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceItems InvoiceItem[]

  @@index([name])
}

enum ProductCategory {
  PVC_PIPE
  PVC_BEND
  PVC_CHANNEL
  WIRE
  ELECTRICAL_ACCESSORY
}

//
// INVOICE
//
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String
  date          DateTime
  vehicleNumber String?

  // Buyer relation
  buyerId String
  buyer   Buyer  @relation(fields: [buyerId], references: [id])

  // Buyer snapshot
  buyerNameSnapshot    String
  buyerAddressSnapshot String
  buyerGstinSnapshot   String?
  buyerPhoneSnapshot   String?

  // Seller snapshot
  sellerNameSnapshot    String
  sellerAddressSnapshot String
  sellerGstinSnapshot   String
  sellerEmailSnapshot   String
  sellerPhoneSnapshot   String

  // Financials
  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @db.Decimal(10, 2)

  // Tax rates
  cgstRate Decimal @db.Decimal(5, 2)
  sgstRate Decimal @db.Decimal(5, 2)
  igstRate Decimal @db.Decimal(5, 2)

  // Tax amounts
  cgstAmount Decimal @db.Decimal(10, 2)
  sgstAmount Decimal @db.Decimal(10, 2)
  igstAmount Decimal @db.Decimal(10, 2)

  total         Decimal @db.Decimal(10, 2)
  amountInWords String

  // Status & Notes
  status       InvoiceStatus @default(PENDING)
  internalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items              InvoiceItem[]
  statusChangeEvents InvoiceStatusLog[]
  printJobs          EpsonPrintJob[]

  @@index([buyerId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([date])
}

enum InvoiceStatus {
  PENDING
  PAID
  CHEQUE_ISSUED
  ARCHIVED
}

//
// INVOICE ITEM
//
model InvoiceItem {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Snapshot fields
  description String
  hsn         String
  qty         Decimal @db.Decimal(10, 2)
  unit        String
  rate        Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)

  // Ordering
  position Int

  @@index([invoiceId])
  @@index([productId])
}

//
// STATUS CHANGE LOG
//
model InvoiceStatusLog {
  id        String        @id @default(cuid())
  invoiceId String
  oldStatus InvoiceStatus
  newStatus InvoiceStatus
  changedAt DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([newStatus])
}

//
// SETTINGS (singleton row, id="singleton")
//
model Settings {
  id           String   @id @default("singleton")
  bankAccounts Json     @default("[]")
  updatedAt    DateTime @updatedAt
}

//
// EPSON CONNECT OAUTH STATE (singleton row, id="singleton")
// Not user-facing / not editable through Settings -- only the token refresh
// logic and the one-time initial seed write here.
//
model EpsonConnection {
  id                   String   @id @default("singleton")
  accessToken          String
  refreshToken         String
  accessTokenExpiresAt DateTime
  refreshedAt          DateTime @updatedAt
  createdAt            DateTime @default(now())
}

//
// EPSON PRINT JOB (one row per print attempt -- an invoice can have several)
//
model EpsonPrintJob {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  epsonJobId String   @unique
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([invoiceId])
}
